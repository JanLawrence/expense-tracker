// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int        @id @default(autoincrement())
  firstName     String
  middleName    String
  lastName      String
  contactNo     String?    
  countryCode   String     @default("PH")
  startingMoney Float      @default(0)
  paySchedule   Json?      // bi-monthly, monthly, weekly, daiy, bi-weekly {sched: '', income_per_sched: {}}
  avatar        Json?      // URL or path to avatar image
  income        Float?     // Optional income field
  expenses      Expense[]
  paymentMode   PaymentMode[]
  auth          UserAuth?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
}

model UserAuth {
  id                Int          @id @default(autoincrement())
  email             String       @unique
  password          String       // Hashed password
  salt              String       // Random salt for password hashing
  resetToken        String?      // For password reset functionality
  resetTokenExpiry  DateTime?    
  isEmailVerified   Boolean      @default(false)
  verificationToken String?      // For email verification
  lastLogin         DateTime?
  userId            Int          @unique      // Foreign key to User table
  user              User         @relation(fields: [userId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
}

model PaymentMode {
  id           Int        @id @default(autoincrement())
  userId       Int          
  user         User       @relation(fields: [userId], references: [id])
  type         String     // "BANK", "CASH", "CREDIT"
  name         String     // Custom name like "Wells Fargo Checking"
  creditLimit  Float?     // Credit limit if applicable
  cutoffDate   DateTime?  @db.Date
  network      String?    // Visa/JCB/Mastercard etc.
  color        String?
  expenses     Expense[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  color     String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}


model Expense {
  id                 Int          @id @default(autoincrement())
  userId             Int          
  user               User         @relation(fields: [userId], references: [id])
  categoryId         Int          
  category           Category     @relation(fields: [categoryId], references: [id])
  paymentModeId      Int
  paymentMode        PaymentMode  @relation(fields: [paymentModeId], references: [id])
  description        String
  remarks            String?
  amount             Float
  shareAmount        Float?       // amount if shared is true
  isShared           Boolean      @default(false)
  showOnReport       Boolean      @default(true)
  isPaidShared       Boolean      @default(false)
  date               DateTime     @default(now())
  isRecurring        Boolean      @default(false)
  recurringStartDate DateTime?    @db.Date
  recurringEndDate   DateTime?    @db.Date
  recurringFrequency String?      
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
}